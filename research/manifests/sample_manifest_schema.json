{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research sample manifest",
  "type": "object",
  "required": [
    "sample_id",
    "dataset_id",
    "language",
    "subject_id",
    "label",
    "task_type",
    "split_role",
    "eval_mode",
    "raw_audio_path",
    "processed_audio_path"
  ],
  "properties": {
    "sample_id": {"type": "string"},
    "dataset_id": {"type": "string", "enum": ["cz_main", "english_external"]},
    "language": {"type": "string", "enum": ["cs", "en"]},
    "subject_id": {"type": "string"},
    "session_id": {"type": ["string", "null"]},
    "label": {"type": "string", "enum": ["Healthy", "Patients"]},
    "task_type": {
      "type": "string",
      "enum": [
        "controlled_vowel",
        "controlled_consonant",
        "controlled_word",
        "picture_description"
      ]
    },
    "speaker_role": {"type": "string", "enum": ["CHI", "EXA", "UNK"]},
    "split_role": {"type": "string", "enum": ["train", "validation", "test", "eval_only"]},
    "eval_mode": {"type": "string", "enum": ["base_manifest", "train_default", "seg_2s", "seg_5s", "full_audio"]},
    "raw_audio_path": {"type": "string"},
    "processed_audio_path": {"type": "string"},
    "interviewer_audio_path": {"type": ["string", "null"]},
    "duration_s": {"type": ["number", "null"], "minimum": 0},
    "sr_original": {"type": ["integer", "null"], "minimum": 1},
    "sr_final": {"type": ["integer", "null"], "minimum": 1},
    "source_format": {"type": ["string", "null"]},
    "diarization_status": {
      "type": "string",
      "enum": ["not_required", "pending", "completed", "failed"]
    },
    "review_status": {"type": ["string", "null"]},
    "review_reason": {"type": ["string", "null"]},
    "auto_qc_flag": {"type": ["string", "null"]},
    "chi_duration_s": {"type": ["number", "null"], "minimum": 0},
    "total_speech_s": {"type": ["number", "null"], "minimum": 0},
    "chi_speech_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "n_detected_speakers": {"type": ["integer", "null"], "minimum": 0},
    "qc_flag": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
